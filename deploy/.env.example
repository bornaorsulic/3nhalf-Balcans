# Copy to deploy/.env on the VM. Never commit it: .env* is gitignored.

# Nebius Managed PostgreSQL. Host and port come from the cluster's "How to connect"
# dialog. sslmode=verify-full needs the Nebius CA, which docs/DEPLOY.md downloads to
# the path CA_CERT_PATH points at; inside the container it is always /etc/ssl/nebius/ca.pem.
DATABASE_URL=postgresql://longevity:password@<cluster-host>:5432/health_agent?sslmode=verify-full&sslrootcert=/etc/ssl/nebius/ca.pem

# Where that CA sits on the VM.
CA_CERT_PATH=/opt/longevity/certs/ca.pem

# The public tunnel URL, exactly as Nebius prints it — scheme, no trailing slash.
PUBLIC_URL=https://web-<tunnel-id>.tunnel.applications.eu-west1.nebius.cloud

# ---------------------------------------------------------------------------
# Provider keys. Everything in this file reaches the backend container via
# `env_file` in docker-compose.yml — no need to list them in `environment:`.
# Server-side only: never prefix them NEXT_PUBLIC_, never import them into React.
# Each is optional; without one the backend falls back to its scripted path.
# ---------------------------------------------------------------------------

# Health Agent model (backend/nebius.py)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=

# Research evidence (backend/amass.py); unset falls back to the research_sources table
AMASS_API_KEY=
AMASS_BASE_URL=

# Voice: speech-to-text and text-to-speech (backend/voice.py)
ELEVENLABS_API_KEY=
