# Copy to deploy/.env on the VM. Never commit it: .env* is gitignored.

# Nebius Managed PostgreSQL. Host from the cluster page, database created by
# scripts/setup_database.py.
DATABASE_URL=postgresql://user:password@<cluster-host>.nebius.cloud:5432/health_agent

# The public tunnel URL, exactly as Nebius prints it — scheme, no trailing slash.
PUBLIC_URL=https://web-<tunnel-id>.tunnel.applications.eu-north1.nebius.cloud
