# Keeps the tunnel up across reboots.
#   sudo cp deploy/nebius-tunnel-agent.service /etc/systemd/system/
#   sudo systemctl enable --now nebius-tunnel-agent

[Unit]
Description=Nebius tunnel agent (Longevity Health Agent)
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/longevity
ExecStart=/opt/longevity/nebius-tunnel-agent -config /opt/longevity/tunnel-agent.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
