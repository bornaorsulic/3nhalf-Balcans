# Copy to .env.local and adjust.

# ---------- Frontend ----------

# Patient view data source.
# "mock" (default): runs fully in the browser on the shared demo data, no backend needed.
# "http": calls the Python backend (backend/api.py) — see docs/PATIENT_API.md and docs/DATABASE.md.
NEXT_PUBLIC_API_MODE=mock

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PATIENT_ID=demo

# ---------- Backend (Python, read by backend/database.py) ----------
# Either set DATABASE_URL, or the PG* variables, or let the scripts ask for the password.

# DATABASE_URL=postgresql://postgres:secret@localhost:5432/health_agent
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGDATABASE=health_agent
# PGPASSWORD=secret

# Origins allowed to call the API from the browser.
# ALLOWED_ORIGINS=http://localhost:5173
