# Copy to .env.local and adjust.

# Patient view data source.
# "mock" (default): runs fully in the browser on the shared demo data, no backend needed.
# "http": calls the real backend at NEXT_PUBLIC_API_BASE_URL (see docs/PATIENT_API.md).
NEXT_PUBLIC_API_MODE=mock

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PATIENT_ID=demo
