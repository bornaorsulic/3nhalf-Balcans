# ---------------------------------------------------------------------------
# Local configuration (.env.local). Next.js reads NEXT_PUBLIC_* values. The
# Python Health Agent also reads provider keys from this file for local
# development; shell exports still take precedence.
# ---------------------------------------------------------------------------

# Where the Python backend lives.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Backend database settings are environment variables in the shell that runs
# uvicorn and the scripts in scripts/:
#
#   export DATABASE_URL=postgresql://postgres:secret@localhost:5432/health_agent
#   uvicorn backend.api:app --reload --port 8000
#
# Without them the defaults are postgres@localhost:5432/health_agent and the
# scripts ask for the password.
#
#   DATABASE_URL      full connection string (takes precedence)
#   PGHOST PGPORT PGUSER PGDATABASE PGPASSWORD
#   ALLOWED_ORIGINS   browser origins allowed to call the API
#                     (default http://localhost:5173,http://localhost:3000)
#   SECURE_COOKIES    set to 1 when serving the API over HTTPS
#   NEBIUS_API_KEY    token for the Nebius OpenAI-compatible vLLM endpoint
#   NEBIUS_BASE_URL   e.g. http://PUBLIC-IP:8000/v1 or HTTPS tunnel ending in /v1
#   NEBIUS_MODEL      served model name from /v1/models
#   NEBIUS_TIMEOUT_SECONDS
#   NEBIUS_MAX_TOKENS
#   AMASS_API_KEY     Amass API token
#   AMASS_BASE_URL    Amass API base URL; if unknown, leave unset to use local research fallback
#   AMASS_TIMEOUT_SECONDS
# ---------------------------------------------------------------------------
